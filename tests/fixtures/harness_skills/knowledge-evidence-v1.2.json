{
  "metadata": {
    "identity": {"namespace": "company-agent", "name": "knowledge-query", "version": "1.2.0"},
    "owner": {"type": "team", "id": "engineering"},
    "visibility": "private",
    "lifecycle": "validated"
  },
  "alias": "knowledge_evidence_candidate",
  "instructions": "For one exact installed Knowledge asset, retrieve Raw evidence for each requested facet. State evidence gaps before any recommendation, and require a direct Raw link for a cross-facet conclusion. Never infer a fit from separate co-mentions. Cite Raw for every material claim.",
  "commands": [
    {"name": "ask", "kind": "capability", "target": {"namespace": "knowledge-query", "name": "ask", "version": "1.0.0"}}
  ],
  "harness_guidance": {
    "domains": ["knowledge"],
    "required_evidence": ["raw_citations"],
    "context_required": true,
    "fallback": "needs_input",
    "max_retries": 0
  },
  "procedure": {
    "kind": "knowledge_query_v1",
    "intent_patterns": [
      "\\bfirmware\\b",
      "市場|規格|選配|技術|競品|競爭對手|知識庫|\\b(?:market|specification|option|technical|competitor|knowledge)\\b"
    ],
    "subject_pattern": "\\b[A-Z]{2,}[A-Z0-9]*[0-9][A-Z0-9]*\\b",
    "facets": [
      {
        "name": "market_trend",
        "request_patterns": ["市場|趨勢|\\bmarket\\b|\\btrend\\b"],
        "search_queries": ["wireless communication market testing demand trend", "wireless industry testing application growth"],
        "support_terms": ["market", "市場", "demand", "趨勢", "industry"],
        "link_terms": ["market", "市場", "demand", "industry"]
      },
      {
        "name": "product_option_spec",
        "request_patterns": ["產品|規格|選配|\\bproduct\\b|\\boption\\b|\\bspec(?:ification)?s?\\b"],
        "search_queries": ["product option specification feature", "tester data sheet option performance"],
        "support_terms": ["option", "spec", "feature", "規格", "產品"],
        "include_subject": true,
        "link_subject": true
      },
      {
        "name": "technical_knowledge",
        "request_patterns": ["技術|測試差異|\\btechnical\\b|\\bsignaling\\b|\\btechnology\\b"],
        "search_queries": ["wireless test technology signaling measurement", "non signaling RF test method"],
        "support_terms": ["measurement", "signaling", "technical", "技術方法"],
        "include_subject": true,
        "link_terms": ["RF testing", "measurement", "signaling", "test method", "technical test", "技術測試"]
      },
      {
        "name": "competitor",
        "request_patterns": ["競品|競爭對手|\\bcompetitor\\b|\\bKeysight\\b|\\bAnritsu\\b|\\bAmarisoft\\b"],
        "search_queries": ["competitor comparison Keysight Anritsu Amarisoft", "competitive battle card alternative"],
        "support_terms": ["competitor", "Keysight", "Anritsu", "Amarisoft", "競品"],
        "include_subject": true,
        "link_terms": ["competitor", "Keysight", "Anritsu", "Amarisoft", "競品"]
      }
    ],
    "relation_terms": ["supports", "fits", "適用", "對應", "compared", "versus", "vs", "compete"],
    "require_relation_for_combination": true
  }
}
