# Checksum-verified source excerpts must never be line-ending converted on checkout.
tests/fixtures/*.txt -text
deploy/windows-preview/validation/** -text
deploy/windows-preview/validation/**/*.pdf binary
# Migrated rs_workflow_system packages are hash-verified (vendored jobs, script entrypoints).
packages/** -text
# Reviewed JEV benchmark corpora are pinned by sha256.
evaluation/jev/*.json -text
benchmarks/coding_v1/fixtures/T*/** -text
benchmarks/coding_v1/fixtures/web/** -text
benchmarks/coding_v1/fixtures/MANIFEST.json -text
benchmarks/coding_v1/runs/**/workspace/** -text
benchmarks/knowledge_v1/questions/source.md -text
# Default Marketplace candidate snapshots are compared byte for byte with their export.
examples/default-marketplace/candidates/*.json -text
# The BI feed fixture vault is hash-verified and its golden answers are compared byte for byte (Atlas vendors them).
tests/fixtures/bi_feed/** -text
# Atlas's dashboard read goldens (BI K2) are vendored byte for byte and drift-checked.
tests/fixtures/atlas_dashboard_golden/** -text
tests/fixtures/atlas_embed_golden/** -text
# Voice test audio is hash-verified by its manifest; never line-ending converted.
tests/fixtures/voice/** binary
# Plugin v1 package and installed-workspace snapshots pin exact byte hashes.
tests/fixtures/plugins_v1/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
