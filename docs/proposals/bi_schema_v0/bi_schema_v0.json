  "rules": [
    {
      "id": "account_not_ecosystem",
      "origin": "source-bi-doc",
      "pages": [
        5
      ],
      "statement": "Account is a customer that buys our instruments; Ecosystem is a supply-chain chip, module or certification partner. They are never mixed: one canonical_key never names both, and an Account reaches an Ecosystem only through suppliers (or a CustomerProduct through chip_modules)."
    },
    {
      "id": "own_solution_vendor",
      "origin": "source-bi-doc",
      "pages": [
        8
      ],
      "statement": "Our TestSolution leaves vendor empty (no vendor link) and there is no Competitor card for our own company. A competitor's TestSolution has exactly one vendor link to its Competitor card. competing_solutions goes from our solution to a competitor's solution."
    },
    {
      "id": "own_solution_explicit",
      "origin": "source-v1.0",
      "statement": "is_own_solution is required and equals 'has no vendor link'."
    },
    {
      "id": "coverage_counts_own_only",
      "origin": "source-bi-doc",
      "pages": [
        8,
        13
      ],
      "statement": "Solution coverage of an Application counts our solutions only; competitor solutions appear only in the comparison."
    },
    {
      "id": "claim_modality",
      "origin": "source-bi-doc",
      "pages": [
        11,
        12
      ],
      "statement": "Every claim separates what the source says (source_assertion) from what we infer (inference), and states assumed / verified (verified only after checking) and draft / reviewed. Uncertain facts go to a to-verify list (verification_status=assumed), never stated as fact. Each claim from a deck cites its page."
    },
    {
      "id": "claim_record_fields",
      "origin": "source-v1.0",
      "statement": "claim_kind, verification_status, review_status and the evidence roles supports / contradicts / context follow kg.claim and kg.claim_evidence of v1.0."
    },
    {
      "id": "concept_review",
      "origin": "source-bi-doc",
      "pages": [
        9,
        12
      ],
      "statement": "A Concept starts as review_state=draft and becomes reviewed after sales have read it."
    },
    {
      "id": "stale_after_90_days",
      "origin": "source-bi-doc",
      "pages": [
        12
      ],
      "statement": "Every card records its sources and updated date; a card not updated for more than 90 days is flagged stale (Atlas graph_state stale, gap STALE_DATA)."
    },
    {
      "id": "node_fixed_set",
      "origin": "source-bi-doc",
      "pages": [
        4
      ],
      "statement": "Node is a fixed set of value-chain positions (the document's wireless set). proposed-v0 extension: further positions for the owner's non-wireless BD scenarios, marked position_set=proposed-v0-extension."
    },
    {
      "id": "import_idempotent_merge",
      "origin": "source-bi-doc",
      "pages": [
        10,
        11
      ],
      "statement": "Imports run dry-run first, are repeatable without duplicate cards, merge into existing cards without overwriting human-written text, keep extraction output out of the published set until reviewed, and keep only summaries and sources, not full source text."
    },
    {
      "id": "assertion_needs_support",
      "origin": "proposed-v0",
      "statement": "A source_assertion claim has at least one supports evidence item."
    },
    {
      "id": "inference_needs_basis",
      "origin": "proposed-v0",
      "statement": "An inference claim lists derived_from_claim_ids and is never verified; a reviewer qualifies the derived Opportunity instead."
    },
    {
      "id": "disputed_needs_both_sides",
      "origin": "proposed-v0",
      "statement": "A disputed claim has both supports and contradicts evidence."
    },
    {
      "id": "domain_range",
      "origin": "proposed-v0",
      "statement": "A relationship's subject type is one of its sources' domains and its object type is in its range."
    },
    {
      "id": "classification_inherits_max",
      "origin": "proposed-v0",
      "statement": "A record takes the highest classification of its evidence documents and its type default (ADR-K8 pending)."
    },
    {
      "id": "label_is_content",
      "origin": "proposed-v0",
      "statement": "Labels of Account, CustomerProduct and Opportunity, or of any CONFIDENTIAL/RESTRICTED record, are content (Knowledge API scope knowledge.read.content)."
    }
  ],
