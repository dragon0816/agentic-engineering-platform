{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:bi.schema:v0",
  "schema_id": "bi.schema/v0",
  "version": "0.1.0",
  "status": "poc-contract",
  "title": "BI Knowledge Schema v0 (PoC contract, not a production schema)",
  "source": {
    "primary": "BI Knowledge Base slides (BDM Business Intelligence Knowledge Base, 17 pages, internal; provided by the owner 2026-10-17; not stored in this repository). Pages cited as x-pages / pages.",
    "secondary": "docs/proposals/KNOWLEDGE_STRATEGY_v1.0_original.md, section 'PostgreSQL Knowledge Graph' (same 12 type names; claim/evidence roles).",
    "origins": {
      "source-bi-doc": "defined in the BI document; name_status 'doc' = the field name appears in the document, 'provisional' = the document describes the field but its name is fixed by bi_schema.py, which is not available",
      "source-v1.0": "defined in the v1.0 proposal only",
      "proposed-v0": "added by this proposal; kept to a minimum, each with a reason"
    },
    "analysis_chain": [
      "Trend",
      "Technology",
      "Node",
      "Ecosystem",
      "CustomerProduct",
      "Application",
      "TestSolution",
      "Opportunity"
    ],
    "analysis_chain_pages": [
      3
    ],
    "doc_node_positions": [
      "chipset",
      "module",
      "handset",
      "cpe",
      "base-station",
      "telecom-network",
      "certification-lab"
    ],
    "doc_node_positions_note": "Slide 4 says 8 fixed nodes but lists 7 (chipset, module, handset, CPE, base station, telecom network, certification lab).",
    "still_unavailable": [
      "bi_schema.py (the document calls it the only authority for field names)",
      "bi_ingest.py",
      "bi_slides_extract.py",
      "the mapping JSON files"
    ]
  },
  "id_rules": {
    "entity_id": "ent-<lowercase entity_type>-<canonical_key>",
    "canonical_key": "^[a-z0-9]+(-[a-z0-9]+)*$, unique per entity_type",
    "relationship_id": "rel-<sha256(subject_entity_id|relationship_type|object_entity_id)[:16]>",
    "claim_id": "clm-<sha256(relationship_id or subject_entity_id|statement)[:16]>",
    "document_id": "src-<sha256(original bytes)[:16]> (existing source_id, src/knowledge/raw.py source_for)",
    "evidence_id": "ev-<sha256(document_id|locator|normalized_text)[:20]> (ADR-K4)"
  },
  "entity_record": {
    "description": "Storage-neutral entity record. The backend stores entity_type plus a properties document; it validates properties against entity_types[entity_type].properties_schema of the schema_id the record names.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "entity_id",
      "entity_type",
      "canonical_key",
      "display_name",
      "properties",
      "schema_id",
      "classification",
      "status",
      "review_status"
    ],
    "properties": {
      "entity_id": {
        "type": "string",
        "pattern": "^ent-[a-z]+-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "entity_type": {
        "enum": [
          "Trend",
          "Technology",
          "Node",
          "Ecosystem",
          "Account",
          "CustomerProduct",
          "Application",
          "TestSolution",
          "Competitor",
          "Concept",
          "Signal",
          "Opportunity"
        ]
      },
      "canonical_key": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "display_name": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "properties": {
        "type": "object"
      },
      "schema_id": {
        "const": "bi.schema/v0"
      },
      "classification": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "CONFIDENTIAL",
          "RESTRICTED",
          "UNCLASSIFIED"
        ]
      },
      "status": {
        "enum": [
          "candidate",
          "reviewed",
          "published",
          "rejected"
        ]
      },
      "review_status": {
        "enum": [
          "draft",
          "reviewed",
          "rejected"
        ]
      },
      "edited_by_human": {
        "type": "boolean"
      },
      "updated": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "x-origin": "source-bi-doc",
        "x-pages": [
          12,
          15
        ],
        "x-name-status": "doc",
        "description": "Card update date; older than 90 days raises a stale reminder."
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "x-origin": "source-bi-doc",
        "x-pages": [
          12
        ],
        "x-name-status": "provisional",
        "description": "Each card keeps its sources."
      }
    }
  },
  "claim_record": {
    "description": "Every relationship and every entity fact is carried by claims. Source rule: distinguish assertion from inference, assumed from verified, draft from reviewed.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "claim_id",
      "subject_entity_id",
      "claim_kind",
      "verification_status",
      "review_status",
      "evidence"
    ],
    "properties": {
      "claim_id": {
        "type": "string",
        "pattern": "^clm-[0-9a-f]{16}$"
      },
      "subject_entity_id": {
        "type": "string"
      },
      "relationship_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "claim_kind": {
        "enum": [
          "source_assertion",
          "inference"
        ]
      },
      "verification_status": {
        "enum": [
          "assumed",
          "verified",
          "disputed"
        ]
      },
      "review_status": {
        "enum": [
          "draft",
          "reviewed",
          "rejected"
        ]
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_id",
            "role"
          ],
          "properties": {
            "evidence_id": {
              "type": "string",
              "pattern": "^ev-[0-9a-f]{20}$"
            },
            "role": {
              "enum": [
                "supports",
                "contradicts",
                "context"
              ]
            }
          }
        }
      },
      "derived_from_claim_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "classification": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "CONFIDENTIAL",
          "RESTRICTED",
          "UNCLASSIFIED"
        ]
      },
      "valid_from": {
        "type": [
          "string",
          "null"
        ]
      },
      "valid_to": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
