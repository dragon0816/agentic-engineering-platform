      "id": "VE-01",
      "title": "沒有方案的 Application",
      "question": "範例 vault 中哪些 Application 沒有任何 Test Solution？哪些只有規劃中（planning）的方案？",
      "expected_entities": [
        "Application:5G-FR2手機產線RF校正",
        "Application:5G-FR2-AiP-OTA驗證",
        "Application:衛星直連-通道模擬驗證",
        "TestSolution:FR2-AiP-OTA緊縮場方案",
        "TestSolution:NTN衛星通道模擬方案"
      ],
      "expected_relationships": [
        {
          "subject": "TestSolution:FR2-AiP-OTA緊縮場方案",
          "relationship": "applications",
          "object": "Application:5G-FR2-AiP-OTA驗證"
        },
        {
          "subject": "TestSolution:NTN衛星通道模擬方案",
          "relationship": "applications",
          "object": "Application:衛星直連-通道模擬驗證"
        }
      ],
      "expected_absent_relationships": [
        {
          "subject": "TestSolution:*",
          "relationship": "applications",
          "object": "Application:5G-FR2手機產線RF校正"
        }
      ],
      "evidence_requirements": {
        "cite_card_and_line": true,
        "must_report_gap": true,
        "notes": "Dashboard caveat: section 6 counts any TestSolution inlink."
      },
      "expected_answer": "「5G-FR2手機產線RF校正」沒有任何 Test Solution（刻意示範缺口）。「5G-FR2-AiP-OTA驗證」與「衛星直連-通道模擬驗證」各有一個我方方案，但兩者 status 都是 planning：已建立但尚不可銷售。Dashboard 第 6 節把 planning 也算成已覆蓋，回答必須分開「已建立」與「可銷售」。範圍限於此範例資料集。",
      "review_domain": "AE",
