{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:knowledge-api:v0.1:quality",
  "title": "Knowledge Quality Metrics",
  "$defs": {
    "QualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault",
        "computed_at",
        "schema_id",
        "entity_counts",
        "relationship_counts",
        "evidence_coverage",
        "claim_modality",
        "review_coverage",
        "gaps"
      ],
      "properties": {
        "vault": {
          "type": "string",
          "minLength": 1
        },
        "computed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "schema_id": {
          "type": "string"
        },
        "entity_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "relationship_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "evidence_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relationships_total",
            "relationships_with_supporting_evidence",
            "ratio"
          ],
          "properties": {
            "relationships_total": {
              "type": "integer",
              "minimum": 0
            },
            "relationships_with_supporting_evidence": {
              "type": "integer",
              "minimum": 0
            },
            "ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "claim_modality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_assertion",
            "inference",
            "verified",
            "assumed",
            "disputed",
            "reviewed",
            "draft"
          ],
          "properties": {
            "source_assertion": {
              "type": "integer",
              "minimum": 0
            },
            "inference": {
              "type": "integer",
              "minimum": 0
            },
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "assumed": {
              "type": "integer",
              "minimum": 0
            },
            "disputed": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed": {
              "type": "integer",
              "minimum": 0
            },
            "draft": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "review_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gap_type",
              "count",
              "example_ids",
              "description"
            ],
            "properties": {
              "gap_type": {
                "description": "Atlas gap_taxonomy (applications/rs_knowledge/schemas/quality-model.yaml).",
                "enum": [
                  "SOURCE_GAP",
                  "PREPROCESS_PROGRAM_GAP",
                  "INGESTION_SKILL_GAP",
                  "METADATA_GAP",
                  "RELATION_GAP",
                  "RETRIEVAL_GAP",
                  "REASONING_GAP",
                  "EXECUTION_GAP",
                  "VALIDATION_GAP",
                  "CONFLICT",
                  "STALE_DATA",
                  "SYSTEM_ERROR"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "example_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "BenchmarkRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_run_id",
        "suite",
        "question_set_version",
        "retrieval_mode",
        "path",
        "started_at",
        "status",
        "synthetic",
        "ground_truth_status",
        "indicative",
        "questions",
        "reviewed_questions",
        "metrics",
        "by_category",
        "telemetry_run_id"
      ],
      "properties": {
        "benchmark_run_id": {
          "type": "string",
          "minLength": 1
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "question_set_version": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_mode": {
          "enum": [
            "wiki",
            "graph",
            "hybrid"
          ]
        },
        "path": {
          "enum": [
            "direct",
            "tool"
          ]
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "ground_truth_status": {
          "enum": [
            "draft-unreviewed",
            "partially-reviewed",
            "reviewed"
          ]
        },
        "indicative": {
          "type": "boolean",
          "description": "true while fewer than the required number of questions are reviewed (v1.2 §5.6)."
        },
        "questions": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_questions": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer_accuracy",
            "evidence_resolvable",
            "evidence_support",
            "modality_labeling",
            "relationship_precision",
            "relationship_recall",
            "relationship_f1",
            "invented_relations",
            "gap_detection",
            "latency_p50_s",
            "latency_p90_s",
            "tokens_mean",
            "loop_rounds_max",
            "graph_hops_max",
            "tool_loop_limit_hits"
          ],
          "properties": {
            "answer_accuracy": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "evidence_resolvable": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "evidence_support": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "modality_labeling": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "relationship_precision": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "relationship_recall": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "relationship_f1": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "invented_relations": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "gap_detection": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "latency_p50_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "latency_p90_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "tokens_mean": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "loop_rounds_max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "graph_hops_max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "tool_loop_limit_hits": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer_accuracy",
              "relationship_f1"
            ],
            "properties": {
              "answer_accuracy": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "relationship_f1": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "telemetry_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BenchmarkRunList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BenchmarkRun"
      }
    }
  }
}
