{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:knowledge-api:v0.1:evidence",
  "title": "Evidence Query: evidence passages and document metadata",
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "document_id",
        "document_version_id",
        "kind",
        "locator",
        "text",
        "text_redacted",
        "described_by",
        "classification",
        "created"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "common.schema.json#/$defs/evidence_id"
        },
        "document_id": {
          "$ref": "common.schema.json#/$defs/document_id"
        },
        "document_version_id": {
          "type": "string",
          "pattern": "^src-[0-9a-f]{16}@[a-z]+\\.v[0-9]+$"
        },
        "kind": {
          "enum": [
            "text",
            "table",
            "image"
          ]
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "slide",
            "section"
          ],
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "slide": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "section": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_redacted": {
          "type": "boolean"
        },
        "described_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification": {
          "$ref": "common.schema.json#/$defs/classification"
        },
        "created": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "EvidenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "vault",
        "title",
        "original_ref",
        "content_redacted",
        "sha256",
        "media_type",
        "versions",
        "classification",
        "synthetic"
      ],
      "properties": {
        "document_id": {
          "$ref": "common.schema.json#/$defs/document_id"
        },
        "vault": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_redacted": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "enum": [
            "pdf",
            "pptx",
            "docx",
            "md"
          ]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_version_id",
              "extractor",
              "raw_ref",
              "created"
            ],
            "properties": {
              "document_version_id": {
                "type": "string",
                "pattern": "^src-[0-9a-f]{16}@[a-z]+\\.v[0-9]+$"
              },
              "extractor": {
                "type": "string",
                "pattern": "^[a-z]+\\.v[0-9]+$"
              },
              "raw_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created": {
                "$ref": "common.schema.json#/$defs/timestamp"
              }
            }
          }
        },
        "classification": {
          "$ref": "common.schema.json#/$defs/classification"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "DocumentList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Document"
      }
    }
  }
}
