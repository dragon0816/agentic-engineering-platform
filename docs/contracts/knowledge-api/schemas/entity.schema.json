{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:knowledge-api:v0.1:entity",
  "title": "Entity Query",
  "$defs": {
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "canonical_key",
        "display_name",
        "display_name_redacted",
        "aliases",
        "properties",
        "schema_id",
        "classification",
        "status",
        "review_status",
        "updated",
        "stale",
        "provenance",
        "updated_at"
      ],
      "properties": {
        "entity_id": {
          "$ref": "common.schema.json#/$defs/entity_id"
        },
        "entity_type": {
          "$ref": "common.schema.json#/$defs/entity_type"
        },
        "canonical_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name_redacted": {
          "type": "boolean"
        },
        "aliases": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "description": "Validated against bi.schema/v1 entity_types[entity_type].properties_schema."
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "$ref": "common.schema.json#/$defs/classification"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "review_status": {
          "$ref": "common.schema.json#/$defs/review_status"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Card update date (BI document: updated)."
        },
        "stale": {
          "type": "boolean",
          "description": "updated is more than 90 days old (BI document rule)."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional (contract 0.1 pre-freeze revision 2026-10-19, ADR-K11): incremented by every accepted change."
        },
        "field_provenance": {
          "type": "object",
          "description": "Optional (ADR-K11): property name -> field provenance; present for every judgement field with a value.",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/field_provenance"
          }
        }
      }
    },
    "EntityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "EntityDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "claims",
        "relationship_counts"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/Entity"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "claim.schema.json#/$defs/Claim"
          }
        },
        "relationship_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "FieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "field",
        "old_value",
        "new_value",
        "status",
        "origin",
        "set_by",
        "set_at",
        "reason",
        "reason_redacted",
        "source_ref",
        "base_version",
        "version"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^chg-[0-9a-f]{12}$"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "old_value": {},
        "new_value": {},
        "status": {
          "enum": [
            "accepted",
            "pending_review",
            "rejected",
            "rejected_stale_base",
            "reverted"
          ]
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/field_origin"
        },
        "set_by": {
          "type": "string",
          "minLength": 1
        },
        "set_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_redacted": {
          "type": "boolean"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "EntityHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "record_version",
        "changes"
      ],
      "properties": {
        "entity_id": {
          "$ref": "common.schema.json#/$defs/entity_id"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldChange"
          }
        }
      }
    }
  }
}
