{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:knowledge-api:v0.1:common",
  "title": "Common definitions of the AEP Knowledge API v0.1",
  "$defs": {
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED",
        "UNCLASSIFIED"
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^src-[0-9a-f]{16}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[0-9a-f]{20}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^ent-[a-z]+-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "relationship_id": {
      "type": "string",
      "pattern": "^rel-[0-9a-f]{16}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^clm-[0-9a-f]{16}$"
    },
    "strategy_run_id": {
      "type": "string",
      "pattern": "^srun-[0-9a-f]{12}$"
    },
    "entity_type": {
      "enum": [
        "Trend",
        "Technology",
        "Node",
        "Ecosystem",
        "Account",
        "CustomerProduct",
        "Application",
        "TestSolution",
        "Competitor",
        "Concept",
        "Signal",
        "Opportunity"
      ]
    },
    "relationship_type": {
      "enum": [
        "related_tech",
        "affects_nodes",
        "node",
        "technologies",
        "applications",
        "competing_solutions",
        "vendor",
        "supplied_technologies",
        "suppliers",
        "account",
        "chip_modules",
        "test_solutions",
        "customer_product",
        "mentions"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed",
        "published",
        "rejected"
      ]
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed",
        "rejected"
      ]
    },
    "claim_kind": {
      "enum": [
        "source_assertion",
        "inference"
      ]
    },
    "verification_status": {
      "enum": [
        "assumed",
        "verified",
        "disputed"
      ]
    },
    "graph_state": {
      "description": "Atlas graph_states vocabulary (applications/rs_knowledge/schemas/quality-model.yaml).",
      "enum": [
        "covered",
        "weak",
        "missing/inferred",
        "conflict/disputed",
        "stale"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_ids",
        "evidence_ids",
        "strategy_id",
        "strategy_run_id",
        "extracted_by",
        "extracted_at",
        "schema_id"
      ],
      "properties": {
        "document_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document_id"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          }
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy_run_id": {
          "$ref": "#/$defs/strategy_run_id"
        },
        "extracted_by": {
          "type": "string",
          "minLength": 1,
          "description": "namespace/name@version of the Skill or capability"
        },
        "extracted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
