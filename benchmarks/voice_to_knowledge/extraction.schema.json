{
  "$defs": {
    "ExtractedClaim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "fact",
            "observation",
            "inference",
            "uncertain"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceSpan"
        },
        "verification_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "source"
      ],
      "title": "ExtractedClaim",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "SourcedCustomer": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "SourcedCustomer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "voice.extraction.mock.v0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "transcript_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    },
    "customer": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcedCustomer"
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ExtractedClaim"
      },
      "maxItems": 99,
      "title": "Claims",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "source_id",
    "transcript_sha256",
    "customer",
    "claims"
  ],
  "title": "Extraction",
  "type": "object"
}
